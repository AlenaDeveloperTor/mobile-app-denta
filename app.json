{
  "expo": {
    "name": "mobile-app-denta",
    "slug": "mobile-app-denta",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mobileappdenta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.romchik_programmist.mobileappdenta"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c275c99b-f1f1-4842-b1f8-d8acb43ab83c"
      }
    }
  }
}
