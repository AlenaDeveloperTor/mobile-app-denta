{
  "expo": {
    "name": "mobile-app-denta",
    "slug": "mobile-app-denta",
    "icon": "./assets/images/logo.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mobileappdenta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.labsmile22.denta",
      "googleServicesFile": "./google-services.json",
       "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F8FC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5dfd270e-571e-42c2-a82d-fd30cf63da6d"
      }
    },
    "owner": "adev67"
  }
}
