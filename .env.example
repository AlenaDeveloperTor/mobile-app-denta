# Скопируйте этот файл в .env и подставьте значения своего окружения.
# Файл .env не коммитьте в git (см. .gitignore).

# Базовый URL backend API.
# Для физического телефона URL должен быть доступен из той же сети.
API_URL=https://api.clinic.com/v1

# Deep link бота MAX. Замените YourBot на имя своего бота.
MAX_BOT_DEEP_LINK=https://max.ru/YourBot?start=

# Ссылка на политику конфиденциальности / обработки ПДн (152-ФЗ)
PRIVACY_POLICY_URL=https://api.clinic.com/v1/privacy-policy

# Firebase Cloud Messaging Sender ID.
# Берётся из google-services.json → project_number.
FCM_SENDER_ID=111111111111111111111

# EAS Project ID для Expo Push Token (getExpoPushTokenAsync).
# Берётся из app.json → extra.eas.projectId или из eas.json.
EAS_PROJECT_ID=a1a1a11a-a1a1-aa11-a1a1-a1a1a1a1a1a1
              
