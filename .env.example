# Скопируйте этот файл в .env и подставьте свои значения
# .env сам по себе в git НЕ коммитится (см. .gitignore)

# Базовый URL бэкенда
API_URL=https://api.clinic.com/v1

# Ссылка для deep-link бота
MAX_BOT_DEEP_LINK=https://max.me/start

# Sender ID Firebase Cloud Messaging (из Firebase-консоли)
FCM_SENDER_ID=your_fcm_sender_id
